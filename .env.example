# ─── Database ─────────────────────────────────────────────────────────────────
# Percent-encode special characters in the password (e.g. ! -> %21, $ -> %24)
DATABASE_URL="postgresql://spadmgrc:<password>@localhost:5432/eunomia"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-secret-here-minimum-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# ─── License Server (Supabase) ────────────────────────────────────────────────
# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"
# Supabase service role key — used server-side only, never exposed to client
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── Evidence Storage ─────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="50"

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="noreply@example.com"
EMAIL_SERVER_PASSWORD="your-email-password"
EMAIL_FROM="Eunomia <noreply@example.com>"
